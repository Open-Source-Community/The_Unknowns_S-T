// ==========================================
// CONFIGURATION
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (For Data Integrity)
// ==========================================

enum UserRole {
  Admin
  Seller
  Buyer
}

enum OrderStatus {
  Pending
  Paid
  Shipped
  Cancelled
}

enum TransactionType {
  Credit
  Debit
}

enum TransactionCategory {
  Deposit
  Purchase
  Refund
  Cashback
  Withdrawal
}

// ==========================================
// MODELS
// ==========================================

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(Buyer)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  
  // Relationships
  wallet        Wallet?
  products      Product[]      @relation("SellerProducts")
  orders        Order[]        @relation("BuyerOrders")
  notifications Notification[]

  @@map("users")
}

model Wallet {
  userId       Int           @id @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  realBalance  Decimal       @default(0.00) @db.Decimal(15, 2) @map("real_balance")
  promoBalance Decimal       @default(0.00) @db.Decimal(15, 2) @map("promo_balance")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  
  // Relationships
  transactions Transaction[]

  @@map("wallets")
}

model Product {
  id          Int             @id @default(autoincrement())
  sellerId    Int             @map("seller_id")
  seller      User            @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    String?         
  price       Decimal         @db.Decimal(10, 2)
  stock       Int             @default(0)
  isHidden    Boolean         @default(false) @map("is_hidden")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  
  // Relationships
  // Vertical Partitioning for performance
  details     ProductDetails? 
  orderItems  OrderItem[]

  @@map("products")
}

// ALTER TABLE products ADD CONSTRAINT price_check CHECK (price >= 0);

model ProductDetails {
  productId   Int      @id @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  description String?  @db.Text 

  @@map("product_details")
}

model Order {
  id          Int           @id @default(autoincrement())
  buyerId     Int           @map("buyer_id")
  buyer       User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  status      OrderStatus   @default(Pending)
  totalAmount Decimal       @default(0.00) @db.Decimal(15, 2) @map("total_amount")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  // Relationships
  items       OrderItem[]
  transactions Transaction[]

  @@map("orders")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  priceAtPurchase Decimal  @db.Decimal(10, 2) @map("price_at_purchase")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model Transaction {
  id          Int                 @id @default(autoincrement())
  walletId    Int                 @map("wallet_id")
  wallet      Wallet              @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  orderId     Int?                @map("order_id") 
  order       Order?              @relation(fields: [orderId], references: [id])
  amount      Decimal             @db.Decimal(15, 2)
  type        TransactionType
  category    TransactionCategory
  referenceId String              @unique @map("reference_id")
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("transactions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}